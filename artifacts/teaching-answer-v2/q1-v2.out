  "evidence_package_state": "PARTIAL",
  "explanation_plan": {
    "direct_answer": "当前占座一致性靠：用户锁/席别锁串行化 + 本地事务原子写座位和车票 + 失败补偿/令牌归还，超时释放和去重仍不完整。",
    "core_mental_model": "先加锁让同一车次席别的占座排队，再在一个数据库事务里把座位改成锁定并写未支付车票；失败就补偿释放座位和令牌，订单侧失败也回调释放。",
    "answer_depth": "detailed",
    "sections": [
      {
        "id": "S1",
        "title": "先说结论：占座一致性靠哪几招？",
        "reader_takeaway": "占座不是单靠一把锁，而是锁排队、事务落库、令牌预扣和失败补偿共同保证。",
        "new_terms": [
          "用户锁",
          "席别锁"
        ],
        "key_points": [
          "购票入口先拿用户锁和席别锁，再进入本地事务占座。",
          "本地事务只操作 ticket 库，远程调用留在事务外。",
          "失败路径通过 cancelCallback 和 returnToken 做补偿。"
        ],
        "evidence_labels": [
          "E10",
          "E22",
          "E11",
          "E14",
          "E15"
        ],
        "target_chars": 200
      },
      {
        "id": "S2",
        "title": "占座到底在改哪些数据？",
        "reader_takeaway": "核心数据是 t_seat.seat_status 和 t_ticket.ticket_status，占座把座位从可售改为锁定并插入未支付车票。",
        "new_terms": [
          "座位状态",
          "车票状态"
        ],
        "key_points": [
          "SeatDO 状态为 0 可售、1 已锁定、2 已出售；支付回调注释为已锁定变已售。",
          "TicketDO 状态为 0 未支付、10 已支付、30 已取消。",
          "占座事务中把座位置 LOCKED，并插入 ticketStatus=UNPAID 的车票记录。"
        ],
        "evidence_labels": [
          "E3",
          "E5",
          "E1",
          "E12"
        ],
        "target_chars": 220
      },
      {
        "id": "S3",
        "title": "并发抢同一座位，为什么只有一个能成功？",
        "reader_takeaway": "用户锁和席别锁先串行化，数据库再用 seat_status=AVAILABLE 条件更新和影响行数校验兜底。",
        "new_terms": [
          "条件更新"
        ],
        "key_points": [
          "用户锁按 username+trainId，席别锁按 trainId+seatType，锁内执行占座。",
          "更新座位时带 seatStatus=AVAILABLE 条件，affectedRows 不等于 seats.size 就抛余票不足。",
          "两把锁在事务外，避免事务快照早于锁建立。"
        ],
        "evidence_labels": [
          "E10",
          "E12",
          "E22"
        ],
        "target_chars": 220
      },
      {
        "id": "S4",
        "title": "座位和车票记录怎么一起成功或一起失败？",
        "reader_takeaway": "doPurchaseInTransaction 用 @Transactional 包住座位更新和车票插入，异常整体回滚；远程建单不在事务里。",
        "new_terms": [
          "事务边界"
        ],
        "key_points": [
          "doPurchaseInTransaction 标注 @Transactional(rollbackFor=Exception.class)。",
          "同一事务里更新座位状态、插入 TicketDO，并组装订单请求，但远程调用留在编排层。",
          "控制器在代理返回后才计成功，说明返回时本地事务已提交。"
        ],
        "evidence_labels": [
          "E12",
          "E11",
          "E28"
        ],
        "target_chars": 220
      },
      {
        "id": "S5",
        "title": "为什么两把锁要放在事务外？",
        "reader_takeaway": "锁在事务外是为了让事务快照建立在拿锁之后，锁内读到最新座位状态，并缩短数据库行锁持有时间。",
        "new_terms": [
          "事务快照"
        ],
        "key_points": [
          "文档明确两把锁都在事务外面，避免事务快照早于锁、锁内读到旧世界。",
          "本地事务层只操作 ticket 数据库，远程调用留在编排层，避免网络等待延长行锁持有时间。"
        ],
        "evidence_labels": [
          "E22",
          "E11"
        ],
        "target_chars": 180
      },
      {
        "id": "S6",
        "title": "建单失败后，已锁座位和令牌怎么回来？",
        "reader_takeaway": "明确建单失败走 compensateKnownFailure 调 cancelCallback 释放座位，令牌在本地事务未提交时归还，已提交后由 cancelCallback 唯一负责。",
        "new_terms": [
          "补偿"
        ],
        "key_points": [
          "本地占座提交后 reservationCommitted=true；若建单失败，调用 cancelCallback 补偿并抛“座位已释放”。",
          "finally 中只有在本地占座未提交时才 returnToken；提交后由 cancelCallback 负责归还令牌。",
          "订单侧超时关单或回滚也通过 rollbackTicketSeats 调 ticketRemoteService.cancelCallback。"
        ],
        "evidence_labels": [
          "E14",
          "E15",
          "E8",
          "E17",
          "E7"
        ],
        "target_chars": 240
      },
      {
        "id": "S7",
        "title": "超时、重复提交和幂等现在都保证了吗？",
        "reader_takeaway": "订单号有幂等校验，但购票占座的重复购买校验仍是未实现占位，超时释放也缺少完整证据，不能说过度保证。",
        "new_terms": [
          "幂等"
        ],
        "key_points": [
          "assertSameCreateRequest 在相同 orderSn 下校验请求头和明细一致，防止订单号被不同请求占用。",
          "TrainPurchaseTicketRepeatChainFilter 目前是未实现占位，注释写明重复购买校验规则未定。",
          "订单结果未知时系统不盲目释放座位，保留 orderSn 等待核对；超时或失败释放路径仍需验证。"
        ],
        "evidence_labels": [
          "E18",
          "E19",
          "E14",
          "E1"
        ],
        "target_chars": 240
      },
      {
        "id": "S8",
        "title": "把整条链路串起来：一致性到底落在哪里？",
        "reader_takeaway": "一致性目标围绕座位状态、余票、购票结果和订单结果；当前实现靠锁、本地事务、令牌和补偿，但超时释放与去重仍有缺口。",
        "new_terms": [],
        "key_points": [
          "历史文档把核心一致性关系概括为座位状态、余票、购票结果、订单结果四者一致。",
          "当前链路是令牌预扣、用户锁和席别锁、本地事务写座位和车票、远程建单、失败补偿或关单回滚。",
          "缺口是占座去重未实现、超时释放缺少完整代码证据，需以恢复任务或对账补齐。"
        ],
        "evidence_labels": [
          "E21",
          "E20",
          "E14",
          "E12",
          "E17",
          "E19"
        ],
        "target_chars": 240
      }
    ],
    "question_kind": "HOW",
    "reader_assumption": "intermediate",
    "likely_misconceptions": [
      "以为占座成功只靠 Redis 令牌，实际令牌只是预扣余票，座位状态才是最终占用依据。",
      "以为分布式锁在事务内，实际两把锁在事务外，避免事务快照早于锁建立。",
      "以为重复提交已经完全防住，实际重复购买过滤器是未实现占位，只有订单号幂等校验。"
    ],
    "decision_source": "llm",
    "plan_schema_version": "teaching_v2"
  },
