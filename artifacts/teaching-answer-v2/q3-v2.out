  "evidence_package_state": "PARTIAL",
  "explanation_plan": {
    "direct_answer": "订单支付链路不靠统一 @Idempotent，主要靠业务唯一键、状态机、条件更新+影响行数判断来幂等。",
    "core_mental_model": "重复请求不是靠一把总锁拦住，而是让数据库在“状态还符合预期”时才改；改不动就说明已处理过或该拒绝。",
    "answer_depth": "detailed",
    "sections": [
      {
        "id": "S1",
        "title": "先给结论：订单支付幂等到底靠什么？",
        "reader_takeaway": "订单支付核心链路不依赖统一 @Idempotent，而是靠业务唯一键、状态机、条件更新和影响行数判断。",
        "new_terms": [
          "幂等",
          "条件更新"
        ],
        "key_points": [
          "文档明确订单支付核心链路不依赖统一 @Idempotent（E16/E18）。",
          "订单状态推进用条件更新+影响行数，重复调用被识别为已处理（E2/E3）。",
          "支付状态推进同样用条件更新+影响行数，不依赖 Redis（E11/E9）。"
        ],
        "evidence_labels": [
          "E16",
          "E18",
          "E2",
          "E3",
          "E11",
          "E9"
        ],
        "target_chars": 170
      },
      {
        "id": "S2",
        "title": "订单创建时，重复下单怎么不被重复受理？",
        "reader_takeaway": "订单创建以 order_sn 为业务唯一键，冲突时校验是否同一请求，不同请求直接拒绝。",
        "new_terms": [
          "业务唯一键",
          "orderSn"
        ],
        "key_points": [
          "文档列订单创建靠 order_sn 唯一索引（E16）。",
          "代码在 orderSn 已存在时比较用户、车次、座位等是否同一创建请求，不同则抛“订单号已被其他购票请求占用”（E14）。",
          "createTicketOrder 是订单服务入口，后续状态推进再靠条件更新（E3/E19）。"
        ],
        "evidence_labels": [
          "E16",
          "E14",
          "E3",
          "E19"
        ],
        "target_chars": 200
      },
      {
        "id": "S3",
        "title": "订单状态推进怎样做到重复回调不重复改？",
        "reader_takeaway": "订单状态用 WHERE status=expected 的条件更新，影响行数决定是否本次生效，重复请求视为已处理。",
        "new_terms": [
          "状态机",
          "影响行数"
        ],
        "key_points": [
          "OrderStateService 把本地状态推进做成独立事务，先提交再通知下游，重试用条件更新+影响行数判断（E2）。",
          "payCallbackOrder 对已支付重复回调直接返回 true；markOrderPaid 未生效也视为已处理（E8）。",
          "订单状态推进全部靠条件更新+影响行数，重复调用不会二次破坏（E3）。"
        ],
        "evidence_labels": [
          "E2",
          "E8",
          "E3"
        ],
        "target_chars": 220
      },
      {
        "id": "S4",
        "title": "支付回调在支付服务侧怎么幂等？",
        "reader_takeaway": "支付服务先校验 paySn 和金额，再用条件更新把 WAIT_PAY 推到已支付，重复回调不重复推进。",
        "new_terms": [
          "paySn",
          "补偿任务"
        ],
        "key_points": [
          "payCallback 校验 paySn、金额，金额不符抛异常（E9）。",
          "已支付时返回通知状态，不重复推进也不重复通知下游（E9）。",
          "更新条件为 paySn + status=WAIT_PAY，影响行数为 0 只记录已并发处理；下游通知失败不回滚支付单，由补偿任务重推（E9/E11）。"
        ],
        "evidence_labels": [
          "E9",
          "E11"
        ],
        "target_chars": 230
      },
      {
        "id": "S5",
        "title": "支付成功后如何通知订单，重复通知怎么处理？",
        "reader_takeaway": "支付服务通过远程调用把支付结果回传订单；订单已支付时重复回调返回 true，让上游停止重推。",
        "new_terms": [],
        "key_points": [
          "支付服务通过 OrderRemoteService.payCallbackOrder 调用订单服务 pay-callback 接口（E20/E21/E10/E19）。",
          "订单侧 payCallbackOrder 对已支付重复回调返回 true；对订单已关闭但收到支付成功记录错误并返回 true 停止重推（E8）。",
          "回调携带 orderSn/paySn 等标识用于定位订单和支付单，但证据未给出两者定义与生成规则（E8/E20/E21）。"
        ],
        "evidence_labels": [
          "E20",
          "E21",
          "E10",
          "E19",
          "E8"
        ],
        "target_chars": 230
      },
      {
        "id": "S6",
        "title": "超时关单和延迟任务重复投递怎么办？",
        "reader_takeaway": "关单任务重复到达时，先看订单是否存在和是否已支付；本地关单用条件更新，下游关支付单和回滚座位可重复执行。",
        "new_terms": [
          "延迟关单",
          "兜底扫表"
        ],
        "key_points": [
          "closeTimeoutOrder 对订单不存在、已支付直接返回；待支付才 closePendingOrder；随后 closePayOrder 和 rollbackTicketSeats 都会补齐（E4）。",
          "延迟关单通过 RDelayedQueue 投递 orderSn，投递失败不影响下单，由兜底扫表补上（E5）。",
          "closePendingOrder 是独立事务方法，保证本地状态先提交再通知下游（E2/E1）。"
        ],
        "evidence_labels": [
          "E4",
          "E5",
          "E2",
          "E1"
        ],
        "target_chars": 230
      },
      {
        "id": "S7",
        "title": "失败、重试和异常分支会怎么处理？",
        "reader_takeaway": "不同异常有不同动作：重复回调返回已处理，重复支付抛异常，金额不符拒绝，已关闭收到支付成功记录人工介入。",
        "new_terms": [
          "人工介入"
        ],
        "key_points": [
          "支付侧 checkOrderCanPay 对待支付放行，已支付抛“订单已支付，无需重复支付”，已取消抛“订单已取消，无法支付”（E13）。",
          "支付回调金额不符直接拒绝；订单号冲突抛“订单号已被其他购票请求占用”（E9/E14）。",
          "支付成功后的下游通知失败不回滚支付单，只把通知状态置未完成，由补偿任务重推（E11）。"
        ],
        "evidence_labels": [
          "E13",
          "E9",
          "E14",
          "E11"
        ],
        "target_chars": 230
      },
      {
        "id": "S8",
        "title": "完整走一遍：重复请求在订单和支付链路会怎样？",
        "reader_takeaway": "两条链路都让数据库条件更新和业务唯一键充当裁判：能推进才推进，推不动就按已处理或异常分支结束。",
        "new_terms": [],
        "key_points": [
          "订单创建靠 order_sn 唯一索引/冲突校验，状态推进靠条件更新+影响行数（E16/E14/E3）。",
          "支付单创建靠 t_pay.order_sn UNIQUE，支付状态推进靠 WHERE status=WAIT_PAY，成功通知失败由补偿（E16/E9/E11）。",
          "订单支付之间用 orderSn/paySn 等标识传递回调，但标识定义、生成规则和一致性保证仍缺证据（E8/E20/E21）。"
        ],
        "evidence_labels": [
          "E16",
          "E14",
          "E3",
          "E9",
          "E11",
          "E8",
          "E20",
          "E21"
        ],
        "target_chars": 230
      },
      {
        "id": "S9",
        "title": "边界和缺口：哪些话不能说得太满？",
        "reader_takeaway": "当前证据能证明订单支付核心幂等策略，但跨链路标识的生成与一致性、票务重复购买校验仍是缺口或未实现。",
        "new_terms": [
          "跨链路标识"
        ],
        "key_points": [
          "ER3 仅部分满足：orderSn/paySn 在回调和远程调用中出现，但定义、生成规则、一致性保证缺失（E8/E20/E21/E19）。",
          "票务侧 TrainPurchaseTicketRepeatChainFilter 仍是占位，不能当作订单支付幂等依据（E12）。",
          "文档说明不依赖统一 @Idempotent，不等于没有幂等要求，而是用业务唯一键+状态机+条件更新+影响行数（E16/E18）。"
        ],
        "evidence_labels": [
          "E8",
          "E20",
          "E21",
          "E19",
          "E12",
          "E16",
          "E18"
        ],
        "target_chars": 230
      }
    ],
    "question_kind": "HOW",
    "reader_assumption": "intermediate",
    "likely_misconceptions": [
      "以为项目用了统一 @Idempotent 或 Redis 锁做幂等；文档明确订单支付核心链路不依赖统一 @Idempotent。",
      "以为重复请求一定返回同一个成功结果；实际已支付重复支付会抛异常，订单已关闭收到支付成功会记录人工核对。",
      "以为 orderSn/paySn 的生成规则和跨链路一致性已经明确；当前证据只显示它们被传递和校验，还缺定义与一致性保证。"
    ],
