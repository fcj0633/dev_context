  "evidence_package_state": "READY",
  "explanation_plan": {
    "answer_goal": "读者能复述当前订单-支付链路保证幂等的统一手法（条件更新 + 影响行数），能沿下单、支付发起、支付回调、关单四个环节指出幂等点分别落在哪段代码上，并说清这套机制的适用边界与不适用场景。",
    "direct_answer": "当前链路没有引入独立的幂等组件或去重表，而是把\"判断条件写进 SQL 的 WHERE\"，用条件更新 + 影响行数在数据库里原子地完成\"判断是否已处理\"和\"推进状态\"，配合订单号/支付单号作为链路幂等键和状态终态收敛，使得任何重复请求、重复回调、重复投递都只是\"影响行数为 0\"的正常语义。",
    "audience_model": "熟悉 Java，但需要建立当前项目的实现模型",
    "core_mental_model": "整条订单-支付链路的幂等来自同一套机制：把状态前置条件写进 WHERE 做条件更新，用影响行数判断\"本次是否取得推进权\"，因此重复请求天然被吸收成\"已处理\"而不会产生二次副作用，跨服务重试可以整条链重跑。",
    "primary_strategy": "PROBLEM_SOLUTION",
    "secondary_strategies": [],
    "prerequisite_concepts": [],
    "likely_misconceptions": [],
    "sections": [
      {
        "id": "S1",
        "title": "链路上的重复从哪来：为什么订单和支付必须先谈幂等",
        "section_type": "PROBLEM_SETUP",
        "teaching_goal": "让读者认识到重复不是异常而是常态（延迟任务重复投递、支付回调重推、用户重复点击、跨服务超时重试），从而理解幂等是链路的基本约束而非补丁。",
        "key_points": [
          "延迟关单任务由延迟队列投递，投递失败还有兜底扫表，同一条 orderSn 可能被处理多次（E3）",
          "支付回调存在重推语义，订单侧必须能识别\"重复回调\"并让支付服务停止重推（E10）",
          "关单任务遇到订单不存在（延迟消息重复投递、订单已被清理）时直接返回，说明重复执行是设计内预期（E5）",
          "回调入口从 ticket-service 暴露，外部重试不可控（E9）"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者认识到重复不是异常而是常态（延迟任务重复投递、支付回调重推、用户重复点击、跨服务超时重试），从而理解幂等是链路的基本约束而非补丁。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E3",
              "E10",
              "E5",
              "E9"
            ],
            "confidence": "CONFIRMED",
            "assumptions": [],
            "conditional": false
          }
        ],
        "evidence_labels": [
          "E3",
          "E10",
          "E5",
          "E9"
        ],
        "teaching_devices": [
          "NONE"
        ],
        "depends_on": [],
