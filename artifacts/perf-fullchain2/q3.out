        "target_tokens": 420
      },
      {
        "id": "S2",
        "title": "统一手法：把判断条件写进 WHERE，用影响行数说话",
        "section_type": "MENTAL_MODEL",
        "teaching_goal": "让读者建立全文的组织轴——\"条件更新 + 影响行数\"是跨订单侧、支付侧、票务侧共用的同一套幂等原语，并理解它为什么优于\"先查再改\"。",
        "key_points": [
          "为什么不用先查再改：查询与修改之间存在并发窗口，两个请求可能都查到旧状态再先后改写（E11 注释明确说明）",
          "把状态条件写进 WHERE，判断与修改在数据库里原子完成，只有拿到推进权的调用才能继续改下游数据（E11）",
          "影响行数为 0 不抛异常——在跨服务重试里它就是\"已经处理过\"的正常语义（E11、E13）",
          "这套机制不依赖 Redis，静态可读、离线也能测（E17、E20）",
          "状态机终态（已支付/已关闭）本身构成收敛点，重复执行只会重新落到同一个终态（E10、E18）"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者建立全文的组织轴——\"条件更新 + 影响行数\"是跨订单侧、支付侧、票务侧共用的同一套幂等原语，并理解它为什么优于\"先查再改\"。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E11",
              "E13",
              "E17",
              "E20",
              "E10",
              "E18"
            ],
            "confidence": "PARTIAL",
