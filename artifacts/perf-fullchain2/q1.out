  "evidence_package_state": "READY",
  "explanation_plan": {
    "answer_goal": "读者能完整复述一次购票占座从请求到落库的写链路，并说明每一层机制分别守住了哪条一致性不变量，以及在失败、超时、取消三种异常路径下数据如何被兜底，同时知道当前方案在幂等/防重方面的证据边界。",
    "direct_answer": "当前实现并不依赖分布式事务或一把大锁，而是靠“入口限流 + 按用户/席别加 Redis 锁串行化 + 只操作 ticket 库的本地事务原子地条件更新座位状态并写车票记录 + 事务提交后再做缓存失效、延迟关单与令牌归还 + 失败补偿与取消回滚”这一整套写链路，把“有占用必有订单、没成功必无占用”这条不变量守住，余票则由座位状态派生。",
    "audience_model": "熟悉 Java，但需要建立当前项目的实现模型",
    "core_mental_model": "购票占座的一致性 = 一条被锁串行化的写链路（校验限流 → 用户锁/席别锁 → 本地事务里条件更新座位状态并写车票 → 提交后才做周边动作 → 失败补偿与超时回滚），它守住的不变量是“有占用必有订单、没成功必无占用”，而余票只是座位状态派生出来的展示口径。",
    "primary_strategy": "EXECUTION_FLOW",
    "secondary_strategies": [],
    "prerequisite_concepts": [],
    "likely_misconceptions": [],
    "sections": [
      {
        "id": "S1",
        "title": "一句话结论：一致性由一条写链路串起四份数据",
        "section_type": "DIRECT_ANSWER",
        "teaching_goal": "让读者先拿到可直接复述的结论：一致性不是某个单点机制，而是一条写链路加一条不变量；并明确要一致的四份数据分别是什么。",
        "key_points": [
          "要同时对齐的四份数据：座位状态、余票数量、车票记录、订单结果",
          "核心不变量：有占用必然对应一笔订单；本次请求没成功就必须不留下任何占用",
          "余票不是独立数据源，它是座位状态（可售）的派生物，所以一致性的真正锚点是座位状态",
          "保证手段分三层：入口限流、Redis 锁串行化、单库本地事务 + 提交后动作 + 补偿回滚"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者先拿到可直接复述的结论：一致性不是某个单点机制，而是一条写链路加一条不变量；并明确要一致的四份数据分别是什么。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E16",
