      {
        "id": "S2",
        "title": "为什么占座是个一致性问题：四条关系与三道裂缝",
        "section_type": "PROBLEM_SETUP",
        "teaching_goal": "让读者理解为什么不能只写一条 UPDATE 就完事：一次占座要同时改动多份数据，还要跨越本地事务管不到的服务边界。",
        "key_points": [
          "四条关系：座位状态 ↔ 余票数量、座位占用 ↔ 购票结果、购票结果 ↔ 订单结果、支付/取消结果 → 座位状态",
          "第一道裂缝：一次购票要写座位状态、车票记录、订单明细三处，必须同生同死",
          "第二道裂缝：订单创建、通知下游属于远程调用，本地数据库事务覆盖不到，网络等待若放在事务内会拉长行锁持有时间",
          "第三道裂缝：余票是缓存口径，数据库改了缓存未必同步，缓存不一致只会少卖，但座位被错误改回可售会造成超卖——这是设计要彻底堵死的最严重情形"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者理解为什么不能只写一条 UPDATE 就完事：一次占座要同时改动多份数据，还要跨越本地事务管不到的服务边界。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E16",
              "E17",
              "E18",
              "E10",
              "E5"
            ],
            "confidence": "CONFIRMED",
            "assumptions": [],
            "conditional": false
          }
        ],
        "evidence_labels": [
