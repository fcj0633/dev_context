      {
        "id": "S4",
        "title": "原子性与时序：事务边界、锁粒度和提交后动作",
        "section_type": "MECHANISM",
        "teaching_goal": "让读者说清楚“原子性由谁提供、为什么要这样切边界”，以及为什么很多副作用必须等到提交之后才允许发生。",
        "key_points": [
          "事务边界是被刻意收窄的：PurchaseTicketTxService 只操作 ticket 库，远程调用留在编排层，避免网络等待延长行锁持有时间",
          "锁的粒度是“用户 × 车次”加“席别”，含义是同一用户同一车次串行、同一席别串行，不同席别之间可以并行——锁解决的是并发进入，事务解决的是写入原子",
          "座位使用状态机表达：0 可售 / 1 已锁定 / 2 已出售，占座是把可售改为已锁定，回滚时只允许把已锁定改回可售，用条件更新从语义上杜绝“把已售座位改回可售”造成的超卖",
          "提交后才动作：延迟关单消息在 afterCommit 里发送，令牌归还同样注册在事务同步的 afterCommit 中，保证事务回滚时这些副作用不会外泄",
          "跨服务不靠分布式事务：本地事务保证 ticket 库内部原子，跨服务一致性交给幂等 + 补偿 + 延迟消息"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者说清楚“原子性由谁提供、为什么要这样切边界”，以及为什么很多副作用必须等到提交之后才允许发生。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E10",
