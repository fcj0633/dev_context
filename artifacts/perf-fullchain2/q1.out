        "target_tokens": 450
      },
      {
        "id": "S3",
        "title": "从请求到落库：占座写链路的执行顺序",
        "section_type": "EXECUTION_FLOW",
        "teaching_goal": "让读者能在脑内走一遍调用栈：入口做什么、锁在哪里加、事务在哪里开始、哪些动作在事务之外。",
        "key_points": [
          "入口为 PurchaseTicketService.purchaseTickets，先跑责任链 TRAIN_PURCHASE_TICKET_FILTER 做前置过滤，再做登录态与乘车人数量（≤5）校验，并按席别聚合出 seatTypeCounts",
          "入口限流：按车次+出发站做令牌桶 takeToken，拿不到令牌直接拒绝，把并发挡在写链路之外",
          "reserveLocally 是锁的所在：先按 username+trainId 获取用户锁，再对本次涉及的每个席别逐个获取席别锁，锁范围覆盖整个占座写过程",
          "锁内调用 PurchaseTicketTxService.doPurchaseInTransaction（@Transactional(rollbackFor = Exception.class)），事务内加载车次/区间关系/票价，由 SeatAllocator 选座并写座位与车票记录",
          "事务提交之后才做余票缓存失效，且缓存删除失败只记警告、依赖缓存过期兜底，不把失败反灌回已提交的占座结果"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者能在脑内走一遍调用栈：入口做什么、锁在哪里加、事务在哪里开始、哪些动作在事务之外。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E1",
              "E2",
              "E4",
              "E3",
              "E10",
              "E5"
            ],
            "confidence": "CONFIRMED",
            "assumptions": [],
            "conditional": false
          }
        ],
        "evidence_labels": [
