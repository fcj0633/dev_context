  "explanation_plan": {
    "answer_goal": "读者能复述该项目在购票链路中避免超卖的多层机制：Redis 令牌桶原子预占、Redisson 用户/席别分布式锁、ticket 库本地事务、提交后事件、幂等补偿与定时兜底；同时能指出当前证据只证明“令牌预占”，尚未展示直接库存字段扣减。",
    "direct_answer": "项目用“Redis 令牌桶原子预占 + Redisson 分布式锁串行化同用户/同席别 + ticket 库本地事务 + 建单后提交回调/幂等补偿”的组合来避免超卖；但 ER1 仍是 PARTIAL，证据只覆盖令牌预占，未直接展示库存字段扣减代码。",
    "audience_model": "熟悉 Java，但需要建立当前项目的实现模型",
    "core_mental_model": "先用令牌桶做全局原子预占，再用分布式锁把同一用户和同一席别的并发购票串行化，最后把本地票库操作收进一个事务，失败或提交后用幂等补偿与兜底任务把令牌和票状态拉回一致。",
    "primary_strategy": "PROBLEM_SOLUTION",
    "secondary_strategies": [],
    "prerequisite_concepts": [],
    "likely_misconceptions": [],
    "sections": [
      {
        "id": "S1",
        "title": "超卖为什么会在购票链路里出现",
        "section_type": "PROBLEM_SETUP",
        "teaching_goal": "建立问题背景：购票链路上同车次、同席别、多用户并发时，若库存判断和扣减不在同一原子边界内，就会出现超卖；项目需要同时处理并发争抢、锁范围、事务边界和失败恢复。",
        "key_points": [
          "同一车次同一席别的高并发请求会同时读到“有票”并各自尝试占用，这是超卖的直接诱因。",
          "项目先引入令牌桶做全局准入，takeToken 通过 Redis Lua 脚本原子执行，降低并发穿透到数据库的压力。",
          "购票入口 purchaseTickets 还会走过滤链、登录校验和乘车人数量校验，但真正的并发控制发生在令牌预占与后续加锁阶段。",
          "订单服务与票务服务分离后，本地事务只能覆盖 ticket 库，订单创建与库存释放需要靠提交后事件和补偿来衔接。"
        ],
        "claim_plans": [
          {
            "claim_goal": "建立问题背景：购票链路上同车次、同席别、多用户并发时，若库存判断和扣减不在同一原子边界内，就会出现超卖；项目需要同时处理并发争抢、锁范围、事务边界和失败恢复。",
            "claim_type": "PROJECT_FACT",
