    "schema_version": 2,
    "original_query": "项目购票流程中，是如何保证数据一致性的，避免超卖问题",
    "requirements": [
      {
        "id": "ER1",
        "target": "项目购票流程中存在库存扣减的代码实现，并明确了扣减的执行逻辑与调用位置。",
        "success_criteria": "证据需包含执行库存扣减的方法或代码片段，并说明其在购票链路中的调用顺序及扣减方式（如直接更新库存字段、使用数据库原子操作等）。",
        "priority": "CORE",
        "temporal_scope": "CURRENT",
        "source_requirement": "CODE"
      },
      {
        "id": "ER2",
        "target": "项目购票流程中采用了防止超卖的并发控制手段，并明确了其具体实现或配置。",
        "success_criteria": "证据需包含项目采用的并发控制机制（如数据库锁、乐观锁版本号、分布式锁、队列串行化等）的具体实现或配置，并说明其作用在购票流程的哪个环节。",
        "priority": "CORE",
        "temporal_scope": "CURRENT",
        "source_requirement": "CODE"
      },
      {
        "id": "ER3",
        "target": "项目购票流程中定义了事务边界以保障库存数据一致性，并明确了库存操作与订单创建是否在同一事务或最终一致性方案内。",
        "success_criteria": "证据需包含购票流程中事务的开启、提交或回滚边界，以及库存操作与订单创建是否在同一事务或最终一致性方案内。",
        "priority": "CORE",
        "temporal_scope": "CURRENT",
        "source_requirement": "CODE"
      },
      {
        "id": "ER4",
        "target": "项目购票流程中对库存不足或并发冲突定义了处理与补偿逻辑。",
        "success_criteria": "证据需包含当库存扣减失败、并发冲突或超卖风险出现时，系统如何响应（如抛出异常、返回错误码、重试、回滚、补偿）的具体代码或文档说明。",
        "priority": "SUPPORTING",
        "temporal_scope": "CURRENT",
        "source_requirement": "ANY"
      }
    ],
