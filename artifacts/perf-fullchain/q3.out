  "evidence_package_state": "PARTIAL",
  "explanation_plan": {
    "answer_goal": "读者读完能理解：用户表分片键选 username 不是偏好，而是由「用户维度最频繁查询入口」决定的必然结果，并能说出不用 id 分片的代价与手机号/邮箱路径的补偿设计。",
    "direct_answer": "因为用户模块几乎所有关键查询（登录、注册、查资料、查乘车人）都从用户名出发，分片键必须与查询键一致才能单分片命中；按 id 分片会让这些路径全部退化为广播查询。",
    "audience_model": "熟悉 Java，但需要建立当前项目的实现模型",
    "core_mental_model": "分片键不是选主键，而是选最频繁、最关键的查询入口——用户模块的入口收敛在 username，所以 t_user 按 username 分片。",
    "primary_strategy": "CAUSE_EFFECT",
    "secondary_strategies": [],
    "prerequisite_concepts": [],
    "likely_misconceptions": [],
    "sections": [
      {
        "id": "S1",
        "title": "分片路由的硬约束：查询条件决定能不能定位到某张表",
        "section_type": "MENTAL_MODEL",
        "teaching_goal": "让读者先建立判断分片键是否合理的标准：分片算法只能按分片键做路由，查询条件里不带分片键就无法定位单表。",
        "key_points": [
          "分片算法把分片键的哈希值映射到具体的库/表后缀，只有拿到分片键的值才能算出目标表。",
          "查询条件里不带分片键，ShardingSphere 无法裁剪，只能把语句广播到所有分片再聚合。",
          "因此「分片键必须与查询键一致」是选型的硬约束，而不是可优化的偏好。"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者先建立判断分片键是否合理的标准：分片算法只能按分片键做路由，查询条件里不带分片键就无法定位单表。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E1",
              "E2",
              "E4",
              "E5",
              "E20",
              "E12",
              "E16"
            ],
            "confidence": "PARTIAL",
            "assumptions": [],
            "conditional": false
          }
        ],
        "evidence_labels": [
