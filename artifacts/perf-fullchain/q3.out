      },
      {
        "id": "S2",
        "title": "用户模块的查询入口为什么收敛在用户名",
        "section_type": "CAUSE",
        "teaching_goal": "让读者看到用户模块的实际访问模式：登录、注册查重、查资料、查乘车人这些高频路径全部以 username 为入口，从而理解 username 成为分片键的直接原因。",
        "key_points": [
          "登录与注册查重以用户名为入口，用户名唯一性约束使这个入口天然可路由。",
          "乘车人列表、乘车人写操作同样按当前登录用户的用户名发起，与 t_user 同键可避免跨库查询。",
          "按 username 哈希分布均匀且基数大，满足分片后数据打散与单分片命中的双重目标。",
          "代价是「按 id 查用户」这类非入口查询会广播，但项目里这类查询不是热点。"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者看到用户模块的实际访问模式：登录、注册查重、查资料、查乘车人这些高频路径全部以 username 为入口，从而理解 username 成为分片键的直接原因。",
            "claim_type": "PROJECT_FACT",
