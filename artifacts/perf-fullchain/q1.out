        "teaching_devices": [
          "NONE"
        ],
        "depends_on": [],
        "evidence_state": "CONFIRMED",
        "target_tokens": 420
      },
      {
        "id": "S2",
        "title": "mark 分组、order 排序、Handler 承载规则：责任链把顺序和扩展点都变成声明",
        "section_type": "MECHANISM",
        "teaching_goal": "让读者看清这套责任链的最小机制——三个接口方法即可解释全部设计动因，理解结构本身就是对上述问题的回答。",
        "key_points": [
          "处理器抽象只有三项契约：mark() 声明属于哪条链、order() 声明在链中的位置、handler(param) 声明做什么",
          "容器 AbstractChainContext 在启动时（CommandLineRunner）从 ApplicationContext 按 mark 收集全部 Handler，再按 order 排序存入 Map<mark, List<Handler>>，业务侧只需 handler(mark, param)",
          "用 CommandLineRunner + ApplicationContext 收集而非构造注入，是为了避免 Handler 反向依赖 Service 造成的构造循环——扩展点的独立性与依赖方向被一并解决",
          "具体规则即一个类：如注册链的 UserRegisterParamNotNullChainHandler 以 order=0 表示最先执行，规则内容与它在链中的位置在同一处声明",
          "这套容器在 user-services 与 ticket-services 中各有一份同形态实现，被多条链路复用"
        ],
        "claim_plans": [
          {
            "claim_goal": "让读者看清这套责任链的最小机制——三个接口方法即可解释全部设计动因，理解结构本身就是对上述问题的回答。",
            "claim_type": "PROJECT_FACT",
            "evidence_labels": [
              "E1",
              "E2",
              "E4",
              "E5",
              "E3",
              "E10"
            ],
            "confidence": "PARTIAL",
            "assumptions": [],
            "conditional": false
          }
        ],
        "evidence_labels": [
          "E1",
