  "evidence_package_state": "READY",
  "explanation_plan": {
    "answer_goal": "读者读完能在脑中复述：购票占座的一致性由三层机制分工实现——锁在事务外做并发串行化、本地事务加条件更新做原子占座、跨服务用状态机+幂等+补偿走向最终一致；并能指出防超卖的最终防线与哪些环节只是最终一致。",
    "direct_answer": "当前实现不是用一个大事务包住全链路，而是三层叠加：Redis 用户锁 + 席别锁（都加在数据库事务之外）把同一用户、同一车次同一席别的并发占座串行化；@Transactional 的本地事务内用“仅 AVAILABLE 才改成 LOCKED”的条件更新加影响行数校验，保证占座与写车票同生共死；跨出本地库的订单/支付一致性则靠状态机推进、幂等条件更新与补偿重推达到最终一致。",
    "audience_model": "读者熟悉 Spring、Redis、关系型数据库的基本概念，能读懂 Java 代码，但没有读过这个项目的购票链路；容易默认“一致性”就等于分布式事务或一把大锁，不知道锁与事务的嵌套顺序本身就是一个设计要点。",
    "core_mental_model": "购票占座的一致性被打散成三层：锁在事务外负责“不许同时抢”，本地事务负责“要么都成要么都不成”，跨服务只能靠状态机+幂等+补偿走向“最终都成”。",
    "primary_strategy": "LAYERED_ARCHITECTURE",
    "secondary_strategies": [
      "EXECUTION_FLOW",
      "CAUSE_EFFECT",
      "FAILURE_ANALYSIS",
      "TRADEOFF"
    ],
    "prerequisite_concepts": [
      "数据库本地事务与回滚",
      "Spring @Transactional 的回滚规则与传播行为",
      "Redis 分布式锁（Redisson RLock）的基本语义",
      "MVCC 快照读的基本概念",
      "最终一致性与补偿/重试",
      "幂等与条件更新"
    ],
    "likely_misconceptions": [
      "以为这条链路的一致性是由一个分布式事务或一把全局大锁统一保证的",
      "以为只要“加了锁”就安全，不知道锁与事务的嵌套顺序（锁必须在事务外）才是关键",
      "以为占座成功等于座位已售，忽略了中间态 LOCKED 和后续补偿",
      "以为余票缓存是权威库存，不知道缓存删除失败只是降级、会等过期",
      "以为席别锁是防超卖的最终防线，实际上最后一道是带状态条件的 UPDATE 加影响行数校验",
      "把历史设计文档里“占座+写车票+创建订单是一个原子组”的口径当成当前实现"
    ],
    "sections": [
      {
        "id": "S1",
        "title": "先给骨架：三层机制叠出来的占座一致性",
        "section_type": "DIRECT_ANSWER",
        "teaching_goal": "读者第一遍就拿到可复述的三层骨架，后面每节都往这三层上挂细节。",
        "key_points": [
          "第一层（串行化）：用户锁防同一用户重复提交，席别锁把同一车次同一席别的占座串行化，两把锁都在事务外。",
          "第二层（原子性）：占座与写车票在同一个 @Transactional 方法内完成，失败整体回滚。",
          "第三层（最终一致）：跨出本地库的订单、支付、座位状态靠状态机、幂等与补偿重推收敛。"
        ],
