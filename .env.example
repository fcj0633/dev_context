# my12306 remains read-only. Both paths may be changed without re-indexing code.
DEVCONTEXT_CODE_ROOT=D:\\Java-learning\\12306Project\\12306\\my12306
DEVCONTEXT_DOC_ROOT=D:\\Java-learning\\12306Project\\docs

POSTGRES_DB=devcontext
POSTGRES_USER=devcontext
POSTGRES_PASSWORD=devcontext_dev
DATABASE_URL=postgresql://devcontext:devcontext_dev@localhost:5432/devcontext

# DASHSCOPE_API_KEY is intentionally omitted: use the Windows environment variable.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TRANSPORT=curl

# DEEPSEEK_API_KEY is intentionally omitted: use the Windows environment variable.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional role-specific overrides. Empty values continue to use DEEPSEEK_MODEL.
# DEEPSEEK_PLANNER_MODEL=deepseek-flash
# DEEPSEEK_ANSWER_PLANNER_MODEL=deepseek-flash
# DEEPSEEK_ANSWER_MODEL=deepseek-flash
# DEEPSEEK_REVIEWER_MODEL=deepseek-flash
# SOURCE_POLICY_PATH=D:\Java-learning\DevContext\config\source-policy.json
# Legacy programmatic workflow default; new ask uses ANSWER_PROFILE.
# TEACHING_GENERATION_MODE=multi_pass

# Text models: deepseek (default) or OpenAI-compatible gateway
LLM_PROVIDER=deepseek
OPENAI_MODEL=gpt-6.1-sol
# CHATGPT_API_KEY and OPENAI_BASE_URL may come from Windows user/system environment.
# OPENAI_BASE_URL=https://apinebula.ai/v1
OPENAI_CONTEXT_WINDOW=131072
OPENAI_MAX_OUTPUT_TOKENS=32768

# Ordinary ask defaults to Fast + low; Full defaults to high.
ANSWER_PROFILE=fast
# Optional global override; omit to use each profile's default.
# ANSWER_REASONING_EFFORT=high
# Optional total deadline, including retrieval. No hard deadline by default.
# ANSWER_HARD_TIMEOUT_SECONDS=300
ANSWER_FAST_LATENCY_TARGET_SECONDS=45
ANSWER_FULL_LATENCY_TARGET_SECONDS=300
ANSWER_PLANNER_TIMEOUT_SECONDS=180
ANSWER_WRITER_TIMEOUT_SECONDS=240
# Full has independent, more generous external call timeouts.
ANSWER_FULL_PLANNER_TIMEOUT_SECONDS=300
ANSWER_FULL_WRITER_TIMEOUT_SECONDS=600
# Declare only genuine model effort support (unknown models omit the parameter).
# Native deepseek-flash automatically uses low/high; medium is not a native tier.
# LLM_SUPPORTED_REASONING_EFFORTS=low,medium,high
# OPENAI_V3_REASONING_EFFORT and TEACHING_REQUEST_TIMEOUT_SECONDS are legacy-only.
